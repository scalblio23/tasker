# Shared board storage (Upstash Redis). Added automatically when you connect an Upstash
# Redis database to the project from the Vercel Marketplace (Storage tab).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shared attachments (Vercel Blob). Added automatically when you connect a Blob store.
BLOB_READ_WRITE_TOKEN=

# Optional: a passcode everyone must enter once per browser to open the board.
TASKER_PASSCODE=
